<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="o`A@R,GE|w_;)G|Oh_+J" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="/$`P%_sy@.:bLC`vqCCQ"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace settingsDecoder {" line1="" line2="    // ==========================================" line3="    // 1. IMAGE SUITE (STABLE ENCODER/DECODER)" line4="    // ==========================================" line5="" line6="    /**" line7="     * Encode an image asset into a text string registry record" line8="     */" line9="    //% blockId=&quot;sd_encode_image&quot;" line10="    //% block=&quot;encode image $img as record $name&quot;" line11="    //% img.shadow=screen_image_picker" line12="    //% weight=100" line13="    export function encodeImage(img: Image, name: string): void {" line14="        if (!img) return;" line15="        let w = img.width;" line16="        let h = img.height;" line17="        let serialized = w + &quot;,&quot; + h + &quot;,&quot;;" line18="        for (let y = 0; y &lt; h; y++) {" line19="            for (let x = 0; x &lt; w; x++) {" line20="                serialized += img.getPixel(x, y) + &quot;,&quot;;" line21="            }" line22="        }" line23="        settings.writeString(&quot;IMG_&quot; + name, serialized);" line24="    }" line25="" line26="    /**" line27="     * Decode an image asset from a text string registry record (Oval Variable Type)" line28="     */" line29="    //% blockId=&quot;sd_decode_image&quot;" line30="    //% block=&quot;decode image from record $name&quot;" line31="    //% weight=95" line32="    export function decodeImage(name: string): Image {" line33="        let rawData = settings.readString(&quot;IMG_&quot; + name);" line34="        if (!rawData) return image.create(16, 16);" line35="" line36="        let commaIndex1 = rawData.indexOf(&quot;,&quot;);" line37="        if (commaIndex1 &lt; 0) return image.create(16, 16);" line38="        let wStr = rawData.substr(0, commaIndex1);" line39="        let a = parseInt(wStr);" line40="" line41="        let remaining = rawData.substr(commaIndex1 + 1, rawData.length - (commaIndex1 + 1));" line42="        let commaIndex2 = remaining.indexOf(&quot;,&quot;);" line43="        if (commaIndex2 &lt; 0) return image.create(a, 16);" line44="        let hStr = remaining.substr(0, commaIndex2);" line45="        let i = parseInt(hStr);" line46="" line47="        let img = image.create(a, i);" line48="        let pixelsStr = remaining.substr(commaIndex2 + 1, remaining.length - (commaIndex2 + 1));" line49="" line50="        let x2 = 0;" line51="        let y2 = 0;" line52="        while (pixelsStr.length &gt; 0) {" line53="            let nextComma = pixelsStr.indexOf(&quot;,&quot;);" line54="            if (nextComma &lt; 0) break;" line55="            let valStr = pixelsStr.substr(0, nextComma);" line56="            let val = parseInt(valStr);" line57="            img.setPixel(x2, y2, val);" line58="" line59="            x2++;" line60="            if (x2 &gt;= a) {" line61="                x2 = 0;" line62="                y2++;" line63="                if (y2 &gt;= i) break;" line64="            }" line65="            pixelsStr = pixelsStr.substr(nextComma + 1, pixelsStr.length - (nextComma + 1));" line66="        }" line67="        return img;" line68="    }" line69="" line70="    // ==========================================" line71="    // 2. LOCATION SUITE (COMPILER-SAFE VERSION)" line72="    // ==========================================" line73="" line74="    /**" line75="     * Save a tile location's column and row coordinates directly to memory" line76="     */" line77="    //% blockId=&quot;sd_save_tile_location&quot;" line78="    //% block=&quot;save tile location $loc to slot $name&quot;" line79="    //% loc.shadow=maplocationidentity" line80="    //% weight=90" line81="    export function saveTileLocation(loc: tiles.Location, name: string): void {" line82="        if (!loc) return;" line83="        let serialized2 = loc.col + &quot;,&quot; + loc.row + &quot;,&quot;;" line84="        settings.writeString(&quot;LOC_TILE_&quot; + name, serialized2);" line85="    }" line86="" line87="    /**" line88="     * Instantly teleports a target sprite to the saved coordinates stored in memory" line89="     */" line90="    //% blockId=&quot;sd_teleport_to_saved_location&quot;" line91="    //% block=&quot;teleport sprite $sprite to saved location from slot $name&quot;" line92="    //% sprite.shadow=variables_get" line93="    //% weight=85" line94="    export function teleportToSavedLocation(sprite: Sprite, name: string): void {" line95="        if (!sprite) return;" line96="        let rawData2 = settings.readString(&quot;LOC_TILE_&quot; + name);" line97="        if (!rawData2) return;" line98="" line99="        let commaIndex = rawData2.indexOf(&quot;,&quot;);" line100="        if (commaIndex &lt; 0) return;" line101="" line102="        let col = parseInt(rawData2.substr(0, commaIndex));" line103="        let row = parseInt(rawData2.substr(commaIndex + 1));" line104="" line105="        // Find the target tile on the active map and place the sprite directly onto it" line106="        let targetLocation = tiles.getTileLocation(col, row);" line107="        tiles.placeOnTile(sprite, targetLocation);" line108="    }" line109="" line110="    // ==========================================" line111="    // 3. TILEMAP SUITE (COMPILER-SAFE VERSION)" line112="    // ==========================================" line113="" line114="    /**" line115="     * Automatically capture and save the active tilemap layout the player is currently inside" line116="     */" line117="    //% blockId=&quot;sd_encode_current_tilemap&quot;" line118="    //% block=&quot;encode current tilemap as $name&quot;" line119="    //% weight=80" line120="    export function encodeCurrentTilemap(name: string): void {" line121="        let scene = game.currentScene();" line122="        if (!scene || !scene.tileMap || !scene.tileMap.data) return;" line123="" line124="        let tilemapData = scene.tileMap.data;" line125="        let b = tilemapData.width;" line126="        let j = tilemapData.height;" line127="        let serializedData = b + &quot;,&quot; + j + &quot;,&quot;;" line128="" line129="        for (let row2 = 0; row2 &lt; j; row2++) {" line130="            for (let col2 = 0; col2 &lt; b; col2++) {" line131="                let tileVal = tilemapData.getTile(col2, row2);" line132="                serializedData += tileVal + &quot;,&quot;;" line133="            }" line134="        }" line135="        settings.writeString(&quot;TM_DATA_&quot; + name, serializedData);" line136="    }" line137="" line138="    /**" line139="     * Reads a saved tilemap string from memory and instantly applies it onto the live scene grid" line140="     */" line141="    //% blockId=&quot;sd_load_and_draw_saved_tilemap&quot;" line142="    //% block=&quot;load and draw saved tilemap from slot $name&quot;" line143="    //% weight=75" line144="    export function loadAndDrawSavedTilemap(name: string): void {" line145="        let rawData3 = settings.readString(&quot;TM_DATA_&quot; + name);" line146="        if (!rawData3) return;" line147="" line148="        let scene2 = game.currentScene();" line149="        if (!scene2 || !scene2.tileMap || !scene2.tileMap.data) return;" line150="" line151="        let commaIndex12 = rawData3.indexOf(&quot;,&quot;);" line152="        if (commaIndex12 &lt; 0) return;" line153="        let c = parseInt(rawData3.substr(0, commaIndex12));" line154="" line155="        let remaining2 = rawData3.substr(commaIndex12 + 1);" line156="        let commaIndex22 = remaining2.indexOf(&quot;,&quot;);" line157="        if (commaIndex22 &lt; 0) return;" line158="        let k = parseInt(remaining2.substr(0, commaIndex22));" line159="" line160="        let pixelsStr2 = remaining2.substr(commaIndex22 + 1);" line161="" line162="        let col3 = 0;" line163="        let row3 = 0;" line164="        while (pixelsStr2.length &gt; 0) {" line165="            let nextComma2 = pixelsStr2.indexOf(&quot;,&quot;);" line166="            if (nextComma2 &lt; 0) break;" line167="            let val2 = parseInt(pixelsStr2.substr(0, nextComma2));" line168="" line169="            // Apply the tile index directly onto the live operational scene grid" line170="            scene2.tileMap.data.setTile(col3, row3, val2);" line171="" line172="            col3++;" line173="            if (col3 &gt;= c) {" line174="                col3 = 0;" line175="                row3++;" line176="                if (row3 &gt;= k) break;" line177="            }" line178="            pixelsStr2 = pixelsStr2.substr(nextComma2 + 1);" line179="        }" line180="" line181="        // Force the active engine to refresh and redraw the visual map background instantly" line182="        scene2.tileMap.setData(scene2.tileMap.data);" line183="    }" line184="" line185="    // ==========================================" line186="    // 4. STORAGE UTILITIES &amp; CHECKS" line187="    // ==========================================" line188="" line189="    /**" line190="     * Check if a specific data record key exists anywhere in the system memory" line191="     */" line192="    //% blockId=&quot;sd_record_exists&quot;" line193="    //% block=&quot;saved record $name exists&quot;" line194="    //% weight=65" line195="    export function recordExists(name: string): boolean {" line196="        if (settings.exists(&quot;TM_DATA_&quot; + name)) return true;" line197="        if (settings.exists(&quot;LOC_TILE_&quot; + name)) return true;" line198="        if (settings.exists(&quot;IMG_&quot; + name)) return true;" line199="        return false;" line200="    }" line201="" line202="    /**" line203="     * Clear specific memory profiles tied to tag target names" line204="     */" line205="    //% blockId=&quot;sd_clear_record&quot;" line206="    //% block=&quot;clear saved record data $name&quot;" line207="    //% weight=60" line208="    export function clearRecord(name: string): void {" line209="        settings.remove(&quot;TM_DATA_&quot; + name);" line210="        settings.remove(&quot;LOC_TILE_&quot; + name);" line211="        settings.remove(&quot;IMG_&quot; + name);" line212="    }" line213="" line214="    /**" line215="     * Reset complete system registry layout configuration entries" line216="     */" line217="    //% blockId=&quot;sd_clear_all&quot;" line218="    //% block=&quot;clear all encoded assets&quot;" line219="    //% weight=55" line220="    export function clearAll(): void {" line221="        let tmKeys = settings.list(&quot;TM_DATA_&quot;);" line222="        for (let l of tmKeys) settings.remove(l);" line223="        let imgKeys = settings.list(&quot;IMG_&quot;);" line224="        for (let m of imgKeys) settings.remove(m);" line225="        let locKeys = settings.list(&quot;LOC_TILE_&quot;);" line226="        for (let n of locKeys) settings.remove(n);" line227="    }" line228="}" numlines="229"></mutation></block></statement></block></xml>