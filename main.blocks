<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="6ObWmm%cM}jLRLqKiuc_" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="!IDg3m8_:(#1AAZo+tlj"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace settingsDecoder {" line1="" line2="    // ==========================================" line3="    // 1. IMAGE ENCODERS &amp; DECODERS" line4="    // ==========================================" line5="" line6="    /**" line7="     * Encode an image asset into a text string registry record" line8="     */" line9="    //% blockId=&quot;sd_encode_image&quot;" line10="    //% block=&quot;encode image $img as record $name&quot;" line11="    //% img.shadow=screen_image_picker" line12="    //% weight=100" line13="    export function encodeImage(img: Image, name: string): void {" line14="        if (!img) return;" line15="        let w = img.width;" line16="        let h = img.height;" line17="        let serialized = w + &quot;,&quot; + h + &quot;,&quot;;" line18="        for (let y = 0; y &lt; h; y++) {" line19="            for (let x = 0; x &lt; w; x++) {" line20="                serialized += img.getPixel(x, y) + &quot;,&quot;;" line21="            }" line22="        }" line23="        settings.writeString(&quot;IMG_&quot; + name, serialized);" line24="    }" line25="" line26="    /**" line27="     * Decode an image asset from a text string registry record" line28="     */" line29="    //% blockId=&quot;sd_decode_image&quot;" line30="    //% block=&quot;decode image from record $name&quot;" line31="    //% weight=90" line32="    export function decodeImage(name: string): Image {" line33="        let rawData = settings.readString(&quot;IMG_&quot; + name);" line34="        if (!rawData) return image.create(16, 16);" line35="" line36="        let commaIndex1 = rawData.indexOf(&quot;,&quot;);" line37="        if (commaIndex1 &lt; 0) return image.create(16, 16);" line38="        let wStr = rawData.substr(0, commaIndex1);" line39="        let a = parseInt(wStr);" line40="" line41="        let remaining = rawData.substr(commaIndex1 + 1, rawData.length - (commaIndex1 + 1));" line42="        let commaIndex2 = remaining.indexOf(&quot;,&quot;);" line43="        if (commaIndex2 &lt; 0) return image.create(a, 16);" line44="        let hStr = remaining.substr(0, commaIndex2);" line45="        let i = parseInt(hStr);" line46="" line47="        let img = image.create(a, i);" line48="        let pixelsStr = remaining.substr(commaIndex2 + 1, remaining.length - (commaIndex2 + 1));" line49="" line50="        let x2 = 0;" line51="        let y2 = 0;" line52="        while (pixelsStr.length &gt; 0) {" line53="            let nextComma = pixelsStr.indexOf(&quot;,&quot;);" line54="            if (nextComma &lt; 0) break;" line55="            let valStr = pixelsStr.substr(0, nextComma);" line56="            let val = parseInt(valStr);" line57="            img.setPixel(x2, y2, val);" line58="" line59="            x2++;" line60="            if (x2 &gt;= a) {" line61="                x2 = 0;" line62="                y2++;" line63="                if (y2 &gt;= i) break;" line64="            }" line65="            pixelsStr = pixelsStr.substr(nextComma + 1, pixelsStr.length - (nextComma + 1));" line66="        }" line67="        return img;" line68="    }" line69="" line70="    // ==========================================" line71="    // 2. LOCATION / COORDINATE ENCODERS &amp; DECODERS" line72="    // ==========================================" line73="" line74="    /**" line75="     * Save specific X and Y positions straight to flash storage memory" line76="     */" line77="    //% blockId=&quot;sd_save_coordinate&quot;" line78="    //% block=&quot;save position x $x y $y as $name&quot;" line79="    //% weight=80" line80="    export function saveCoordinate(x: number, y: number, name: string): void {" line81="        let serialized2 = x + &quot;,&quot; + y + &quot;,&quot;;" line82="        settings.writeString(&quot;LOC_&quot; + name, serialized2);" line83="    }" line84="" line85="    /**" line86="     * Read saved coordinate data as a plain text string" line87="     */" line88="    //% blockId=&quot;sd_decode_coordinates_str&quot;" line89="    //% block=&quot;get raw coordinate string $name&quot;" line90="    //% weight=70" line91="    export function decodeCoordinatesStr(name: string): string {" line92="        let rawData2 = settings.readString(&quot;LOC_&quot; + name);" line93="        if (!rawData2) return &quot;&quot;;" line94="        return rawData2;" line95="    }" line96="" line97="    // ==========================================" line98="    // 3. TILEMAP ENCODERS &amp; DECODERS" line99="    // ==========================================" line100="" line101="    /**" line102="     * Encode a raw layer image layout out into flash registry settings strings" line103="     */" line104="    //% blockId=&quot;sd_encode_tilemap&quot;" line105="    //% block=&quot;encode tilemap data $tmMap as $name&quot;" line106="    //% tmMap.shadow=screen_image_picker" line107="    //% weight=60" line108="    export function encodeTilemapImage(tmMap: Image, name: string): void {" line109="        if (!tmMap) return;" line110="        let b = tmMap.width;" line111="        let j = tmMap.height;" line112="        let serializedData = b + &quot;,&quot; + j + &quot;,&quot;;" line113="" line114="        for (let row = 0; row &lt; j; row++) {" line115="            for (let col = 0; col &lt; b; col++) {" line116="                let tileIndex = tmMap.getPixel(col, row);" line117="                serializedData += tileIndex + &quot;,&quot;;" line118="            }" line119="        }" line120="        settings.writeString(&quot;TM_&quot; + name, serializedData);" line121="    }" line122="" line123="    /**" line124="     * Decode tilemap strings back into a clean Image canvas format" line125="     */" line126="    //% blockId=&quot;sd_decode_tilemap&quot;" line127="    //% block=&quot;decode tilemap image from record $name&quot;" line128="    //% weight=50" line129="    export function decodeTilemapImage(name: string): Image {" line130="        let rawData3 = settings.readString(&quot;TM_&quot; + name);" line131="        if (!rawData3) return image.create(16, 16);" line132="" line133="        let commaIndex12 = rawData3.indexOf(&quot;,&quot;);" line134="        if (commaIndex12 &lt; 0) return image.create(16, 16);" line135="        let wStr2 = rawData3.substr(0, commaIndex12);" line136="        let c = parseInt(wStr2);" line137="" line138="        let remaining2 = rawData3.substr(commaIndex12 + 1, rawData3.length - (commaIndex12 + 1));" line139="        let commaIndex22 = remaining2.indexOf(&quot;,&quot;);" line140="        if (commaIndex22 &lt; 0) return image.create(c, 16);" line141="        let hStr2 = remaining2.substr(0, commaIndex22);" line142="        let k = parseInt(hStr2);" line143="" line144="        let layersImage = image.create(c, k);" line145="        let pixelsStr2 = remaining2.substr(commaIndex22 + 1, remaining2.length - (commaIndex22 + 1));" line146="" line147="        let col2 = 0;" line148="        let row2 = 0;" line149="        while (pixelsStr2.length &gt; 0) {" line150="            let nextComma2 = pixelsStr2.indexOf(&quot;,&quot;);" line151="            if (nextComma2 &lt; 0) break;" line152="            let valStr2 = pixelsStr2.substr(0, nextComma2);" line153="            let val2 = parseInt(valStr2);" line154="            layersImage.setPixel(col2, row2, val2);" line155="" line156="            col2++;" line157="            if (col2 &gt;= c) {" line158="                col2 = 0;" line159="                row2++;" line160="                if (row2 &gt;= k) break;" line161="            }" line162="            pixelsStr2 = pixelsStr2.substr(nextComma2 + 1, pixelsStr2.length - (nextComma2 + 1));" line163="        }" line164="        return layersImage;" line165="    }" line166="" line167="    // ==========================================" line168="    // 4. GENERAL SYSTEM MEMORY MANAGEMENT" line169="    // ==========================================" line170="" line171="    /**" line172="     * Clear specific memory profiles tied to tag target names" line173="     */" line174="    //% blockId=&quot;sd_clear_encode&quot;" line175="    //% block=&quot;clear encode data $name&quot;" line176="    //% weight=40" line177="    export function clearEncode(name: string): void {" line178="        settings.remove(&quot;TM_&quot; + name);" line179="        settings.remove(&quot;IMG_&quot; + name);" line180="        settings.remove(&quot;LOC_&quot; + name);" line181="    }" line182="" line183="    /**" line184="     * Reset complete system registry layout configuration entries" line185="     */" line186="    //% blockId=&quot;sd_clear_all&quot;" line187="    //% block=&quot;clear all encoded assets&quot;" line188="    //% weight=30" line189="    export function clearAll(): void {" line190="        let tmKeys = settings.list(&quot;TM_&quot;);" line191="        for (let l of tmKeys) settings.remove(l);" line192="        let imgKeys = settings.list(&quot;IMG_&quot;);" line193="        for (let m of imgKeys) settings.remove(m);" line194="        let locKeys = settings.list(&quot;LOC_&quot;);" line195="        for (let n of locKeys) settings.remove(n);" line196="    }" line197="}" numlines="198"></mutation></block></statement></block></xml>